title = "§I_Pause"
metadata/command = "§I_Pause"

[node name="Data" type="VBoxContainer" parent="UI/VBox/VSplit/Middle/HSplit/EditArea/HBox/Editor/ScrollContainer/VBox/IPause" unique_id=2054889097]
layout_mode = 2

[node name="Node" parent="UI/VBox/VSplit/Middle/HSplit/EditArea/HBox/Editor/ScrollContainer/VBox/IPause/Data" unique_id=1707873520 node_paths=PackedStringArray("parent_container") instance=ExtResource("2_guh61")]
layout_mode = 2
label_text = "Image Player:"
parent_container = NodePath("../..")
line_key = "Node"
label_tooltip = "The image node to pause.

For static images, this pauses the countdown until the image stops being displayed. For animated images, this pauses both the countdown and the animation.

Provide either the name of an image node in your media_players_locations in Candy_Engine.gd (i.e. the same name as the folders in Candy_DE/Media/Images), or a path to one (e.g. $/root/path/TextureRect).

Use standard variable symbols (default: £, $ or €) to provide a variable reference, NOT 'super' symbols. Standard symbols do not conflict with node path references."

[node name="Lines" parent="UI/VBox/VSplit/Middle/HSplit/EditArea/HBox/Editor/ScrollContainer/VBox/IPause/Data" unique_id=1695576423 node_paths=PackedStringArray("parent_container") instance=ExtResource("2_guh61")]
layout_mode = 2
label_text = "Number of Lines:"
parent_container = NodePath("../..")
line_key = "Lines"
label_tooltip = "The number of dialogue lines to process before the image countdown (and optionally the animation) resumes automatically.

Set to 0 to disable: only the §IResume command will resume the countdown/animation."

[node name="All" parent="UI/VBox/VSplit/Middle/HSplit/EditArea/HBox/Editor/ScrollContainer/VBox/IPause/Data" unique_id=1973985376 node_paths=PackedStringArray("parent_container") instance=ExtResource("2_guh61")]
layout_mode = 2
label_text = "Line Type:"
parent_container = NodePath("../..")
line_key = "All"
label_tooltip = "Whether all types of lines should count towards the number of processed lines, or only Spoken Lines should count.

0 = Only Spoken Lines are counted.
1 = All lines are counted.

Note: §Comment and §LM commands are never counted."

[node name="Box" parent="UI/VBox/VSplit/Middle/HSplit/EditArea/HBox/Editor/ScrollContainer/VBox/IPause/Data" unique_id=283787243 node_paths=PackedStringArray("parent_container") instance=ExtResource("2_guh61")]
layout_mode = 2
label_text = "Show/Hide Text:"
parent_container = NodePath("../..")
line_key = "Box"
label_tooltip = "Whether to change the Z-Index of the dialogue box, subtitles, speech bubbles, or chat box, so that they are visible above / hidden below the image.

-1 = Reset the Z-Index to the default (hide under the image).
0 = No change to the Z-Index.
1 = Set the Z-Index to that of the image node + 1 (show above the image)."

[node name="Portrait" parent="UI/VBox/VSplit/Middle/HSplit/EditArea/HBox/Editor/ScrollContainer/VBox/IPause/Data" unique_id=1524539874 node_paths=PackedStringArray("parent_container") instance=ExtResource("2_guh61")]
layout_mode = 2
label_text = "Show/Hide Portrait:"
parent_container = NodePath("../..")
line_key = "Portrait"
label_tooltip = "Whether to change the Z-Index of the portrait display, so that it is visible above / hidden below the image.

-1 = Reset the Z-Index to the default (hide under the image).
0 = No change to the Z-Index.
1 = Set the Z-Index to that of the image node + 1 (show above the image)."

