Set to 0 to display the image indefinitely."

[node name="Time" parent="UI/VBox/VSplit/Middle/HSplit/EditArea/HBox/Editor/ScrollContainer/VBox/Image/Data" unique_id=323901556 node_paths=PackedStringArray("parent_container") instance=ExtResource("2_guh61")]
