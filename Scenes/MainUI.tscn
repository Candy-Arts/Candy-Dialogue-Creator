[node name="VVolume" type="FoldableContainer" parent="UI/VBox/VSplit/Middle/HSplit/EditArea/HBox/Editor/ScrollContainer/VBox" unique_id=1766875625]
visible = false
layout_mode = 2
tooltip_text = "Adjust the volume of a video player."
theme_override_font_sizes/font_size = 20
title = "§V_Volume"
metadata/command = "§V_Volume"

[node name="Data" type="VBoxContainer" parent="UI/VBox/VSplit/Middle/HSplit/EditArea/HBox/Editor/ScrollContainer/VBox/VVolume" unique_id=1918225146]
layout_mode = 2

[node name="Node" parent="UI/VBox/VSplit/Middle/HSplit/EditArea/HBox/Editor/ScrollContainer/VBox/VVolume/Data" unique_id=719421281 node_paths=PackedStringArray("parent_container") instance=ExtResource("2_guh61")]
layout_mode = 2
label_text = "Video Player:"
parent_container = NodePath("../..")
line_key = "Node"
label_tooltip = "The VideoStreamPlayer to change the volume of.

Provide either the name of a VideoStreamPlayer in your media_players_locations in Candy_Engine.gd (i.e. the same name as the folders in Candy_DE/Media/Video), or a path to one (e.g. $/root/path/VideoStreamPlayer).

Use standard variable symbols (default: £, $ or €) to provide a variable reference, NOT 'super' symbols. Standard symbols do not conflict with node path references."

[node name="Volume" parent="UI/VBox/VSplit/Middle/HSplit/EditArea/HBox/Editor/ScrollContainer/VBox/VVolume/Data" unique_id=1469107652 node_paths=PackedStringArray("parent_container") instance=ExtResource("2_guh61")]
layout_mode = 2
label_text = "Volume Value:"
parent_container = NodePath("../..")
line_key = "Volume"
label_tooltip = "The value to change volume by/to.

Prefix the value with + or - for relative adjustment.
E.g. a value of '5' will set the volume to 5, and a value of '+5' will increase the volume by 5.

Set to 0 or leave empty to disable progressive volume change."

[node name="Time" parent="UI/VBox/VSplit/Middle/HSplit/EditArea/HBox/Editor/ScrollContainer/VBox/VVolume/Data" unique_id=722032317 node_paths=PackedStringArray("parent_container") instance=ExtResource("2_guh61")]
layout_mode = 2
label_text = "Volume Progression:"
parent_container = NodePath("../..")
line_key = "Time"
label_tooltip = "Makes the volume change progressive over the provided amount of time.

E.g. a value of '3' will make the volume increase or decrease progressively over 3 seconds, until it reaches the value provided in the Volume data field.

HH:MM:SS.00 format."

