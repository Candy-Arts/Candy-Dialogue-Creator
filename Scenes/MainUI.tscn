list_logic = "ExportMethod"
label_tooltip = "The behavior if a file with the same name and extension already exists:
Overwrite: overwrites the existing file.
Skip: skips exporting if a file already exists.
Duplicate: exports a file with an incremental number added to the name. E.g. \"File.txt\" → \"File(1).txt\"
Timestamp: exports a file with the current date and time added to the name."

