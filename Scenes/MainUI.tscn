[node name="Wait" parent="UI/VBox/VSplit/Middle/HSplit/EditArea/HBox/Editor/ScrollContainer/VBox/Image/Data" unique_id=361232227 node_paths=PackedStringArray("parent_container") instance=ExtResource("2_guh61")]
